# Environment Variables Template
# Copy this file to .env.local for local development
# For production, configure these in Vercel Dashboard

# Public site URL used for absolute URLs in metadata, sitemap, and OG tags.
# Set this to your production domain so social previews and search engines
# resolve correctly.
NEXT_PUBLIC_SITE_URL=https://visualizer-gold.vercel.app

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Get one at https://analytics.google.com (Admin → Data Streams → Web → Measurement ID)
# Leave empty in development to disable GA in dev.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (only the value, not the full meta tag)
# Get one at https://search.google.com/search-console → Add property → HTML tag
# Example: NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=abcdef1234567890
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Note: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Keep sensitive keys without this prefix.
